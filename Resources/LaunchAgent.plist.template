<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.machi47.liquidglass.agent</string>
    <key>ProgramArguments</key>
    <array><string>__AGENT_EXECUTABLE__</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ProcessType</key><string>Interactive</string>
    <key>ThrottleInterval</key><integer>3</integer>
    <key>StandardOutPath</key><string>__STDOUT__</string>
    <key>StandardErrorPath</key><string>__STDERR__</string>
</dict>
</plist>
